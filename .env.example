# AI Provider API Keys（三选一即可，支持故障转移）
GLM_API_KEY=your_glm_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
OPENCODEZEN_API_KEY=your_opencodezen_api_key_here

# App Config
APP_ENV=development
# 鉴权开关：未设置时按 APP_ENV 判定（development=关，其他=开）。生产务必设为 true
# AUTH_ENABLED=true
# JWT 签名密钥：生产务必改为强随机串（如 openssl rand -hex 32）
SECRET_KEY=please_change_to_a_strong_random_string
# 管理员口令：生产务必修改（或改用 ADMIN_PASSWORD_HASH bcrypt 哈希）
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=$2b$12$...   # 推荐：用 bcrypt 哈希替代明文
# 登录限流（防暴力破解）
LOGIN_RATE_LIMIT=5/minute

# Frontend Config
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=量化策略研究平台
